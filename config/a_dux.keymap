#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <10 11>;
            layers = <0>;
        };

        Rpar {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <6 7>;
        };

        Dash {
            bindings = <&kp MINUS>;
            key-positions = <5 6>;
        };

        Lpar {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <2 3>;
        };

        Lbrc {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <12 13>;
        };

        Rbrc {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <17 16>;
        };

        Rbkt {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <26 27>;
        };

        Lbkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <22 23>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <15 16>;
        };

        excamation {
            bindings = <&kp EXCLAMATION>;
            key-positions = <3 4>;
        };

        and {
            bindings = <&kp AMPERSAND>;
            key-positions = <13 14>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <25 26>;
        };

        up {
            bindings = <&kp UP_ARROW>;
            key-positions = <2 7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // This is a sample keymap intended to be replaced with your own

        base_layer {
            bindings = <
&none     &none  &none  &kp P  &kp Y                                               &kp F               &kp G  &kp C  &kp R  &kp L
&kp A     &kp O  &kp E  &kp U  &kp I                                               &kp D               &kp H  &kp T  &kp N  &kp S
&kp SEMI  &kp Q  &kp J  &kp K  &kp X                                               &kp B               &kp M  &kp W  &kp V  &kp Z
                               &mt LEFT_SHIFT SPACE  &mo 0    &mt LCTRL BACKSPACE  &mt LEFT_ALT ENTER
            >;
        };
    };
};
